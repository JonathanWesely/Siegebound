+			// OUR file is the SAME VALUE in the editor and in the packaged game.
+			TestEqual(TEXT("⭐⭐ …and `bIsDefaultTransform` is SPELLED rather than defaulted — it is the argument that decides whether the vendor template's scale is substituted for ours, and a literal here cannot vary by build target"),
+				CountOccurrencesInCode(SpawnBody, TEXT("/*bIsDefaultTransform=*/ false")), 1);
+		}
+	}
+
+	// ── ⭐⭐⭐ (b) THE HAZARD THIS ROW COULD MOST EASILY HAVE SHIPPED, AS AN EXECUTABLE BAN ────
+	// ⛔⛔ THE VENDOR CONSTRUCTION SCRIPT BUILDS ITS DYNAMIC MATERIAL INSTANCE FROM `BoxMaterials`
+	// ⛔ AND PUSHES ITS OWN SCALARS INTO THAT INSTANCE — density, noise sharpness and wind speed,
+	// i.e. ⛔ EVERY NUMBER ASK (B) SHIPPED (`TASK-1152`). ⇒ swapping the mesh's material AFTER that
+	// push ⛔ ORPHANS the tuned instance and 🧑 he gets a GREY fog with the ⛔ OLD DENSITY BACK —
+	// ⛔ the colour fix silently REVERTING the uniformity fix, with ⛔ nothing in any log.
+	// ⭐⭐⭐ THIS IS THE UNIFORMITY NON-REGRESSION IN THE ONLY FORM A HEADLESS TEST CAN HOLD: the
+	// production file must ⛔ NEVER set a material on a component and must ⛔ NEVER re-push a
+	// parameter itself. The scalars survive because the ⛔ VENDOR re-pushes them, and the day
+	// somebody "simplifies" this into a direct SetMaterial, these rows go RED instead of his fog
+	// quietly going back to `density 5`.
+	const TCHAR* ForbiddenMaterialShortcuts[] =
+	{
+		TEXT("SetMaterial("),                    // ⛔ swaps the material and orphans the vendor's tuned instance
+		TEXT("CreateDynamicMaterialInstance"),   // ⛔ a SECOND instance the vendor knows nothing about
+		TEXT("SetScalarParameterValue"),         // ⛔ a hand-copied vendor parameter list nothing keeps in sync
+		TEXT("SetVectorParameterValue"),         // ⛔ re-authoring the colour in code, away from the artist's asset
+		// ⛔ THE HELPER, NOT THE MECHANISM — and the distinction is measured, not verbal.
+		// `UWorld::SpawnActorDeferred` (World.h:3851-3869) defaults `TransformScaleMethod` to
+		// ⛔ `MultiplyWithRoot`, which would MULTIPLY this world-sized fog scale by the vendor
+		// component template's own. What the shipped path uses is `SpawnActor` with
+		// `bDeferConstruction`, which keeps `OverrideRootScale`.
+		// ⚖️ ⛔ THE BAN'S ORIGINAL STATED REASON WAS FALSE AND IS CORRECTED HERE RATHER THAN
+		// INHERITED: it claimed the engine comment at `SCS_Node.cpp:144-146` makes
+		// `bIsDefaultTransform` FALSE IN A COOKED BUILD, so any deferred form would differ between
+		// editor and packaged game. ⛔ That comment sits on the `bIsDefaultTransform == TRUE`
+		// branch, i.e. it describes the NON-deferred path — the one `Actor.cpp:4358-4360` reaches
+		// by hardcoding `FinishSpawning(Transform, true)`. Routed to the manager as a law-text
+		// correction; the ban survives on the scale-method hazard above, which is real.
+		TEXT("SpawnActorDeferred"),
+	};
+	for (const TCHAR* Shortcut : ForbiddenMaterialShortcuts)
+	{
+		TestEqual(FString::Printf(TEXT("⛔⛔ The colour goes through the VENDOR's own pipeline — no '%s' anywhere in FogVolume.cpp"), Shortcut),
+			CountOccurrencesInCode(FogCpp, Shortcut), 0);
+	}
+
+	// ── ⭐⭐ (c) THE APPLY SITE: WRITE, VERIFY, REBUILD, MEASURE — IN THAT ORDER ──────────────
+	FString ApplyBody;
+	if (ExtractFunctionBody(*this, FogCpp, ApplyFogVisualMaterialSignature, ApplyBody))
+	{
+		TestEqual(TEXT("⭐⭐ The map entry is written exactly once"),
+			CountOccurrencesInCode(ApplyBody, TEXT("SetObjectPropertyValue(")), 1);
+
+		// ⭐⭐⭐ THE POST-WRITE READBACK. `TASK-1154` set this same map through the editor-scripting
+		// surface TWICE, in two payload shapes; ⛔ BOTH CALLS RETURNED WITHOUT ERROR and ⛔ BOTH READ
+		// BACK UNCHANGED. The only thing between "a green handoff, a commit, and 🧑 him looking at
+		// the same beige" and a caught defect was ⛔ ONE READBACK (`SC-§94` cl. D).
+		TestEqual(TEXT("⭐⭐⭐ THE WRITE IS READ BACK — this exact write has already been seen to SUCCEED AND DO NOTHING, twice, without erroring"),
+			CountOccurrencesInCode(ApplyBody, TEXT("GetObjectPropertyValue(")), 1);
+
+		// 🚨⛔⛔⭐⭐ THE TYPE IS CHECKED **BEFORE** THE STORE, AND THAT ORDER IS THE WHOLE VALUE OF
+		// THE CHECK (`TASK-1166` NIT-2, upgraded on measurement). `SetObjectPropertyValue` carries
+		// ⛔ NO type check of its own, so a vendor retype of this map's value would let the write
+		// SUCCEED, store a wrongly-typed object, and let the readback compare ⛔ THE SAME POINTER
+		// AGAINST ITSELF and report ⛔ GREEN. ⇒ checked after the store it would be decoration;
+		// checked before it, it is the only thing that can see the fault at all.
+		FString BeforeWrite;
+		if (SubstringBefore(*this, ApplyBody, TEXT("SetObjectPropertyValue("), BeforeWrite))
+		{
+			TestEqual(TEXT("🚨⛔⛔ THE MAP'S VALUE TYPE IS CHECKED **BEFORE** THE STORE — the engine's setter has no type check, so a wrong-typed store reads back as the very pointer it was given and verifies itself GREEN"),
+				CountOccurrencesInCode(BeforeWrite, TEXT("RequestedMaterial->IsA(MaterialValueProperty->PropertyClass)")), 1);
+			TestEqual(TEXT("⭐ …and nothing is read back before there is anything to read back"),
+				CountOccurrencesInCode(BeforeWrite, TEXT("GetObjectPropertyValue(")), 0);
+		}
+
+		// ⛔⛔ THE MESH IS NEVER TOUCHED FROM THE WRITE SIDE. The apply step runs BEFORE the mesh
+		// exists at all (construction is deferred), so any material read here would be a read of
+		// nothing — and would report a mismatch on every single cast, forever. The measurement
+		// lives in `VerifyFogVisualMaterial`, on the OTHER side of `FinishSpawning`.
+		TestEqual(TEXT("⭐⭐⭐ THE WRITE SIDE READS NO MESH — it runs before construction, so there is no mesh yet; measuring here would report a mismatch on every cast, forever"),
+			CountOccurrencesInCode(ApplyBody, TEXT("GetMaterial(")), 0);
+		TestEqual(TEXT("⭐⭐ …and it judges nothing about what is rendered — that comparison belongs on the far side of construction"),
+			CountOccurrencesInCode(ApplyBody, TEXT("FogVisualMaterialMatches(")), 0);
+
+		// ⛔ FIND, never FIND-OR-ADD. An add would MANUFACTURE the entry this function is supposed
+		// to be repointing, turning "the vendor no longer has that entry" into a silent success —
+		// and the readback would then happily confirm the value we had just invented.
+		TestEqual(TEXT("⛔⛔ The map entry is FOUND, never FIND-OR-ADDED — an add would manufacture the entry being repointed and turn a missing vendor field into a silent success"),
+			CountOccurrencesInCode(ApplyBody, TEXT("FindOrAdd")), 0);
+
+		// ⛔ The vendor's mode key is resolved BY NAME, never by ordinal. A hardcoded index would
+		// compile, would be right today, and would write the WRONG MODE's material the day the
+		// vendor reorders its list — silently, and only for 🧑 him to notice on pixels.
+		TestTrue(TEXT("⛔ The map key is resolved through the enum BY NAME — a hardcoded ordinal writes the wrong mode the day the vendor reorders its list"),
+			CountOccurrencesInCode(ApplyBody, TEXT("GetDisplayNameTextByIndex(")) >= 1
+			&& CountOccurrencesInCode(ApplyBody, TEXT("GetNameStringByIndex(")) >= 1);
+
+		// ⚠️⚠️ THE ERROR-SITE COUNT IS DECLARED IN THE OPEN, exactly as `TASK-1072` declared its move
+		// from 2 to 3 on the spawn body (`TL-§5b`). ⛔ These sites could have been hidden from any
+		// census by collapsing them into one generic "something went wrong" line — and a counter
+		// that names them is precisely what stops that. ⚠️ IT MOVED 5 ⇒ 6 UNDER `TASK-1166`: the
+		// old site (4) covered TWO different facts in one sentence, and *"still holds None AFTER
+		// BEING SET TO …"* described an attempt that never happened when the entry was absent.
+		// ⛔ A log line that misreports WHICH step failed sends the next reader to the wrong file.
+		// THE SIX, in order:
+		//   (1) the material asset would not load
+		//   (2) the vendor's material map is missing or is not a map of objects
+		//   (3) ⭐ the map's value type will not accept a UMaterialInterface — checked BEFORE the
+		//       store, because the engine's setter has none and a wrong-typed store self-verifies
+		//   (4) the vendor's mode entry no longer exists under that name
+		//   (5) ⭐ the map holds NO entry under that key ⇒ nothing was written (⛔ FIND, not
+		//       FIND-OR-ADD — manufacturing it would make a missing vendor field a silent success)
+		//   (6) ⭐ THE WRITE RETURNED AND CHANGED NOTHING — the measured `TASK-1154` failure
+		// ⛔ The seventh way the colour can fail — the mesh rendering something else — lives on the
+		// far side of construction and is counted in `VerifyFogVisualMaterial` below.
+		TestEqual(TEXT("⭐⭐ Every way the WRITE can fail is announced at Error level, six times — the load, the missing map, a value type that will not accept the material, the missing mode entry, a missing entry to repoint, and a write that did nothing. ⛔ A silent fall-through to the vendor's tint is the exact false-clean this row exists to end"),
+			CountOccurrencesInCode(ApplyBody, TEXT("LogGitClaudeUnrealTest, Error,")), 6);
+
+		// ⛔⛔ FIND, NOT FIND-OR-ADD, AND THE MISS IS ITS OWN BRANCH RATHER THAN A SKIPPED WRITE.
+		// The earlier shape wrote only `if (BaseEntryIndex != INDEX_NONE)` and then fell into the
+		// readback, so a missing entry was reported by a sentence about a write nobody attempted.
+		TestEqual(TEXT("⭐⭐ A MISSING MAP ENTRY IS ITS OWN LOUD BRANCH — not a skipped write reported by a sentence about an attempt that never happened"),
+			CountOccurrencesInCode(ApplyBody, TEXT("if (BaseEntryIndex == INDEX_NONE)")), 1);
+
+		// ⚖️ AND THE BOUNDARY OF "LOUD", RESTATED FOR THE NEW SITE: an ART failure may NEVER refuse
+		// a 50-gold card, consume-and-abort, or change one vision clamp. The fog stays up, it stays
+		// the vendor's warm tint, and the log says which step did not happen.
+		TestEqual(TEXT("⚖️ ⛔ The colour path never returns a refusal — it is void, and an art failure may NEVER brick a 50-gold card"),
+			CountOccurrencesInCode(ApplyBody, TEXT("return false")), 0);
+		TestEqual(TEXT("⚖️ ⛔ …and it never touches a fog deadline, so a failed colour cannot change one clamp"),
+			CountOccurrencesInCode(ApplyBody, TEXT("FogActiveUntilTimeSeconds")), 0);
+		TestEqual(TEXT("⛔ …and it learns nothing about fog STATE — IsFogActive() is still the one predicate, and the reconciler already asked it"),
+			CountOccurrencesInCode(ApplyBody, TEXT("IsFogActive()")), 0);
+
+		// ⛔ No asset literal of its own: it asks the one accessor, exactly as the spawn site asks
+		// FogVisualClassPath().
+		TestEqual(TEXT("⛔ The apply site holds no /Game/ literal of its own — it asks FogVisualMaterialPath()"),
+			CountOccurrencesInCode(ApplyBody, TEXT("/Game/")), 0);
+		TestTrue(TEXT("⭐ …and it really consults that one function"),
+			CountOccurrencesInCode(ApplyBody, TEXT("FogVisualMaterialPath()")) >= 1);
+	}
+
+	// ── ⭐⭐⭐ (c2) THE FAR SIDE OF CONSTRUCTION: WHAT THE MESH IS ACTUALLY WEARING ────────────
+	FString VerifyBody;
+	if (ExtractFunctionBody(*this, FogCpp, VerifyFogVisualMaterialSignature, VerifyBody))
+	{
+		// ⭐⭐⭐ EVERY MESH, EVERY SLOT — ⛔ NOT `FindComponentByClass` + element 0 (`TASK-1166`
+		// NIT-3). The vendor pack is content we do not own: the day it grows a second mesh
+		// component or a second material slot, a first-match-only probe judges whichever one the
+		// component array happened to hold first, ⛔ non-deterministically. ⛔ `GetMaterial(0)` is
+		// banned by shape here, not merely discouraged in a comment.
+		TestEqual(TEXT("⭐⭐⭐ THE READBACK WALKS EVERY MESH AND EVERY SLOT — a vendor that grows a second mesh or a second slot must not make this probe non-deterministic"),
+			CountOccurrencesInCode(VerifyBody, TEXT("GetNumMaterials()")), 1);
+		TestEqual(TEXT("⛔⛔ …so the hardcoded element 0 is GONE — `GetMaterial(0)` assumes a slot count nobody here owns"),
+			CountOccurrencesInCode(VerifyBody, TEXT("GetMaterial(0)")), 0);
+		TestEqual(TEXT("⭐ …and the slot index it does read is the loop's, exactly once"),
+			CountOccurrencesInCode(VerifyBody, TEXT("GetMaterial(SlotIndex)")), 1);
+
+		// ⛔ Unwrap ONLY the transient DYNAMIC instance. `MI_SiegeFog_Grey` is ITSELF a material
+		// instance, so unwrapping every UMaterialInstance would walk straight PAST the answer to
+		// the vendor's parent material and report a mismatch that is not there.
+		TestEqual(TEXT("⛔⛔ The unwrap stops at the DYNAMIC instance — unwrapping every UMaterialInstance walks past our own answer to the vendor's parent and reports a mismatch that is not there"),
+			CountOccurrencesInCode(VerifyBody, TEXT("Cast<UMaterialInstanceDynamic>(")), 1);
+
+		// ⭐⭐ A DISAGREEMENT IS COMPARED, NOT MERELY PRINTED — the scale twin's rule. ⛔ And the
+		// branch that FIRES is the mismatch: a match must stay silent, or the loud case stops
+		// meaning anything.
+		TestEqual(TEXT("⭐⭐ The achieved material is COMPARED against the requested one in code, exactly once"),
+			CountOccurrencesInCode(VerifyBody, TEXT("FogVisualMaterialMatches(FogVisualMaterialPath(), AchievedMaterialPath)")), 1);
+		TestEqual(TEXT("⭐⭐ …and the MISMATCH is the branch that fires — a match stays silent, or the loud case means nothing"),
+			CountOccurrencesInCode(VerifyBody, TEXT("if (!bWearingRequestedMaterial)")), 1);
+		TestEqual(TEXT("⭐⭐ …announced at Error level exactly once — this is the seventh way the colour can fail, and the only one that can see PIXELS-adjacent state"),
+			CountOccurrencesInCode(VerifyBody, TEXT("LogGitClaudeUnrealTest, Error,")), 1);
+
+		// ⚖️ THE BOUNDARY AGAIN, ON THE NEW SITE: an ART failure may NEVER refuse a 50-gold card,
+		// consume-and-abort, or change one vision clamp.
+		TestEqual(TEXT("⚖️ ⛔ The measurement never returns a refusal — it is void and const, and an art failure may NEVER brick a 50-gold card"),
+			CountOccurrencesInCode(VerifyBody, TEXT("return false")), 0);
+		TestEqual(TEXT("⚖️ ⛔ …and it never touches a fog deadline"),
+			CountOccurrencesInCode(VerifyBody, TEXT("FogActiveUntilTimeSeconds")), 0);
+
+		// ⛔ IT MUTATES NOTHING. A "measurement" that repaired what it found would be a second
+		// answer to which material the fog is wearing, and the mismatch Error would then be
+		// reporting a state it had itself just changed.
+		TestEqual(TEXT("⛔⛔ The measurement REPAIRS NOTHING — a readback that fixed what it found would be reporting a state it had itself just changed"),
+			CountOccurrencesInCode(VerifyBody, TEXT("SetObjectPropertyValue(")), 0);
+	}
+
+	TestEqual(TEXT("⭐⭐ The measurement has ONE call site, on the far side of construction"),
+		CountOccurrencesInCode(FogCpp, TEXT("VerifyFogVisualMaterial(Spawned);")), 1);
+	TestEqual(TEXT("⭐ …declared once on the owner, const, because it changes nothing"),
+		CountOccurrencesInCode(FogH, TEXT("void VerifyFogVisualMaterial(const AActor* Visual) const;")), 1);
+
+	// ── ⭐⭐ (d) ONE ASSET REFERENCE, AND THE VENDOR PACK IS NEVER NAMED ──────────────────────
+	FString MaterialPathBody;
+	if (ExtractFunctionBody(*this, FogCpp, FogVisualMaterialPathSignature, MaterialPathBody))
+	{
+		// ⚠️ TWO, not one — the `BP_SiegeFog` precedent above: a single soft-object literal spells
+		// the asset twice, once as the PACKAGE and once as the OBJECT inside it. The claim is "one
+		// literal", and this is what one literal counts as.
+		TestEqual(TEXT("⭐⭐ The grey material is named in exactly ONE path literal in the whole project, inside AFogVolume::FogVisualMaterialPath"),
+			CountOccurrencesInCode(MaterialPathBody, TEXT("MI_SiegeFog_Grey")), 2);
+	}
+
+	TestEqual(TEXT("⛔ The material's /Game/ path appears on CODE lines of FogVolume.cpp only inside that one literal"),
+		CountOccurrencesInCode(FogCpp, TEXT("/Game/Materials/Instances/MI_SiegeFog_Grey")), 1);
+	TestEqual(TEXT("⛔ …and never on a code line of the header (the header names it in PROSE only, which is where a design note belongs)"),
+		CountOccurrencesInCode(FogH, TEXT("MI_SiegeFog_Grey")), 0);
+
+	// ⛔⛔ THE VENDOR PACK IS READ-ONLY (`FOG-§6`), AND THIS IS THE EXECUTABLE FORM OF THAT FENCE:
+	// production code names ZERO paths inside it. The vendor material is a NEGATIVE fixture in
+	// test 10 and it may never become a positive one here.
+	TestEqual(TEXT("⛔⛔ FogVolume.cpp names NOTHING inside the read-only vendor pack — the grey arrives as OUR child material, never as an edit to theirs"),
+		CountOccurrencesInCode(FogCpp, TEXT("/Game/FogArea")), 0);
+
+	// ── ⭐ (e) THE DETECTOR IS A REACHABLE SEAM, not an inline expression ─────────────────────
+	// ⛔⛔ THIS IS WHY TEST 10 CAN EXIST AT ALL — the FogVisualScaleMatches precedent, and the same
+	// reasoning: the same comparison written inline at the apply site would be a check NO TEST
+	// COULD EVER RUN, which is the defect one layer up.
+	TestEqual(TEXT("⭐⭐ The material comparison is a PUBLIC STATIC SEAM a test can execute. ⛔ Inlined at the call site it would be a check nothing could ever run"),
+		CountOccurrencesInCode(FogH, TEXT("static bool FogVisualMaterialMatches(const FSoftObjectPath& RequestedMaterialPath, const FSoftObjectPath& AchievedMaterialPath);")), 1);
+	TestEqual(TEXT("⭐ …declared once, defined once"),
+		CountOccurrencesInCode(FogCpp, TEXT("bool AFogVolume::FogVisualMaterialMatches(")), 1);
+	TestEqual(TEXT("⭐⭐ The asset reference is a function a test can hold, not a literal at a call site"),
+		CountOccurrencesInCode(FogH, TEXT("static const FSoftObjectPath& FogVisualMaterialPath();")), 1);
+	TestEqual(TEXT("⭐ …declared once, defined once"),
+		CountOccurrencesInCode(FogCpp, TEXT("const FSoftObjectPath& AFogVolume::FogVisualMaterialPath()")), 1);
+
+	// ⛔ AND THE ROW'S STANDING FENCES SURVIVE IT: the colour readback stores NOTHING. It is read,
+	// compared, logged and dropped inside one function — the TObjectPtr handle stays the only thing
+	// this class remembers about the visual.
+	// ⚠️ THE NEEDLE CARRIES ITS SEMICOLON for the same reason the scale twin's does:
+	// `AchievedMaterialPath` appears in the header as a PARAMETER NAME, so a bare needle would
+	// assert nothing it means. `AchievedMaterialPath;` is the shape a MEMBER FIELD takes and a
+	// parameter list can never wear.
+	TestEqual(TEXT("⛔ The colour readback introduces NO stored state — it is read, compared, logged and dropped inside one function"),
+		CountOccurrencesInCode(FogH, TEXT("AchievedMaterialPath;")), 0);
+
+	// ⛔ The colour is applied in exactly one place, by exactly one caller. A second call site would
+	// be a second answer to "which material is the fog wearing", which is the shape FOG-§10.1's
+	// one-source rule forbids everywhere else in this class.
+	TestEqual(TEXT("⭐⭐ The colour has ONE application site and ONE caller — a second would be a second answer to which material the fog is wearing"),
+		CountOccurrencesInCode(FogCpp, TEXT("ApplyFogVisualMaterial(Spawned);")), 1);
+	TestEqual(TEXT("⭐ …declared once on the owner, which is where the visual's whole lifetime already lives"),
+		CountOccurrencesInCode(FogH, TEXT("void ApplyFogVisualMaterial(AActor* Visual);")), 1);
+
+	return true;
+}
+
 #endif // WITH_DEV_AUTOMATION_TESTS
