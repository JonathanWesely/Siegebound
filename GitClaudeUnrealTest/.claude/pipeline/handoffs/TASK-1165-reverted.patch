+bool AFogVolume::FogVisualMaterialMatches(const FSoftObjectPath& RequestedMaterialPath, const FSoftObjectPath& AchievedMaterialPath)
+{
+	// ⛔⛔⛔ THE WHOLE POINT OF THIS FUNCTION IS THAT A TEST CAN RUN IT (`SC-§79`), exactly like the
+	// scale twin above. The comparison it makes is trivial; the fact that it is REACHABLE FROM A
+	// TEST is not — and the defect it guards (a colour that reads correct and renders wrong) has
+	// already been measured live on this very Blueprint. ⇒ Tests/SiegeFogVisualTest.cpp hands this
+	// the MEASURED vendor material this row replaces and asserts it answers NO.
+
+	// ⛔⛔ AN EMPTY PATH ON EITHER SIDE IS A MISMATCH, AND IT IS STATED RATHER THAN INHERITED.
+	// Path equality is a plain comparison, so TWO NOTHINGS COMPARE EQUAL: a visual with no mesh,
+	// or a material that failed to resolve, would report a MATCH and this predicate would CERTIFY
+	// THE EXACT SILENCE IT EXISTS TO BREAK. Written in the same `!(X)` form FogVisualScaleMatches
+	// uses for NaN, so the REASON lives on the page instead of resting on an operator's behaviour.
+	if (!RequestedMaterialPath.IsValid() || !AchievedMaterialPath.IsValid())
+	{
+		return false;
+	}
+
+	// ⛔ ACHIEVED against REQUESTED, in that order, because that is the direction the caller cares
+	// about: "is what the mesh is rendering with the thing we asked for?".
+	return AchievedMaterialPath == RequestedMaterialPath;
+}
