+	// ⛔ FIND, never FindOrAdd. An ADD would manufacture the entry this function is supposed to be
+	// REPOINTING and turn "the vendor no longer has a Base material" into a silent success.
+	const int32 BaseEntryIndex = MapHelper.FindMapIndexWithKey(KeyStorage.GetData());
+	if (BaseEntryIndex == INDEX_NONE)
