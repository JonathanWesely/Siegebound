+		// write-did-nothing case below are ⛔ DIFFERENT FACTS — *"there was nothing to write to"* vs
+		// *"the write changed nothing"* — and one sentence covering both would have described an
+		// attempt that never happened. ⛔ A log line that misreports which step failed sends the
+		// next reader to the wrong file.
+		KeyProperty->DestroyValue(KeyStorage.GetData());
+		UE_LOG(LogGitClaudeUnrealTest, Error,
+			TEXT("[%s] ⛔ THE FOG VISUAL HAS NO '%s[%s]' ENTRY TO REPOINT — the mode resolved, but the vendor's map holds no ")
+			TEXT("value under it (AFogVolume::ApplyFogVisualMaterial). ⛔ NOTHING WAS WRITTEN: the entry is FOUND rather than ")
+			TEXT("FIND-OR-ADDED on purpose, because manufacturing it here would turn a missing vendor field into a silent ")
+			TEXT("success that then verifies itself. The fog is UP, the MECHANIC is unaffected and the card is not refused; ")
+			TEXT("the box will render in the VENDOR's warm tint."),
+			*GetNameSafe(this), *BoxMaterialsPropertyName.ToString(), BaseModeEntryName);
+		return;
+	}
+
+	MaterialValueProperty->SetObjectPropertyValue(MapHelper.GetValuePtr(BaseEntryIndex), RequestedMaterial);
+
+	// ⭐⭐⭐ THE POST-WRITE READBACK, AND IT IS HERE BECAUSE ⛔ THIS EXACT WRITE HAS ALREADY BEEN SEEN
+	// TO SUCCEED AND DO NOTHING. TASK-1154 set this same map through the editor-scripting surface
+	// TWICE, in two payload shapes; BOTH CALLS RETURNED WITHOUT ERROR and BOTH READ BACK UNCHANGED.
+	// ⛔ The only thing standing between "a saved asset, a green handoff, a commit, and 🧑 him
+	// looking at the same beige while the board says grey shipped" and a caught defect was ONE
+	// READBACK. ⇒ this is not ceremony and it is not optional.
+	const int32 VerifiedEntryIndex = MapHelper.FindMapIndexWithKey(KeyStorage.GetData());
+	const UObject* const StoredMaterial = (VerifiedEntryIndex != INDEX_NONE)
+		? MaterialValueProperty->GetObjectPropertyValue(MapHelper.GetValuePtr(VerifiedEntryIndex))
+		: nullptr;
+	KeyProperty->DestroyValue(KeyStorage.GetData());
