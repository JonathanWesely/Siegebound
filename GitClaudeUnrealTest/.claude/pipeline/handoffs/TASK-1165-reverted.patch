+void AFogVolume::VerifyFogVisualMaterial(const AActor* const Visual) const
+{
+	if (!IsValid(Visual))
+	{
+		return;
+	}
+
+	// ⭐⭐⭐ MEASURE WHAT THE MESH IS ACTUALLY RENDERING WITH, ⛔ NEVER WHAT WE ASKED FOR.
+	// `ApplyFogVisualMaterial`'s own readback proves the ⛔ FIELD holds our material. It proves
+	// ⛔ NOTHING about whether the vendor's construction script consulted that field — and this
+	// fog's entire history is values that read correct and rendered wrong (`FIELD-§7`, `SC-§94`).
+	// ⚠️ IT ALSO CATCHES, FOR FREE, A CASE NOTHING ELSE HERE LOOKS FOR: if the visual is running in
+	// any mode other than the one whose entry was written, the script builds from a DIFFERENT
+	// entry and the mesh wears the vendor's material ⇒ a mode mismatch arrives as a LOUD material
+	// mismatch instead of as silence.
+	// ⛔⛔ EVERY MESH, EVERY SLOT — ⛔ not `FindComponentByClass` + element 0 (TASK-1166 NIT-3). The
+	// vendor pack is content we do not own: the day it grows a second mesh component or a second
+	// material slot, a first-match-only probe would judge whichever one the component array
+	// happened to hold first, and it would do it ⛔ non-deterministically. Counting what was
+	// inspected also makes ⛔ "there was nothing to measure" a reportable state rather than a
+	// silent pass — a visual with zero mesh slots reaches the Error below saying so.
+	TInlineComponentArray<UMeshComponent*> MeshComponents;
+	Visual->GetComponents(MeshComponents);
+
+	int32 SlotsInspected = 0;
+	bool bWearingRequestedMaterial = false;
+	FString FirstAchievedPath(TEXT("<no mesh material slot on the actor>"));
+
+	for (const UMeshComponent* const Mesh : MeshComponents)
+	{
+		if (!Mesh)
+		{
+			continue;
+		}
+
+		const int32 SlotCount = Mesh->GetNumMaterials();
+		for (int32 SlotIndex = 0; SlotIndex < SlotCount; ++SlotIndex)
+		{
+			const UMaterialInterface* AppliedMaterial = Mesh->GetMaterial(SlotIndex);
+
+			// ⛔ Unwrap ONLY the transient DYNAMIC instance the vendor creates per spawn.
+			// `MI_SiegeFog_Grey` is ITSELF a material instance (a child of the vendor's box
+			// material), so unwrapping every UMaterialInstance would walk straight PAST the answer
+			// to the vendor's parent and report a mismatch that is not there.
+			while (const UMaterialInstanceDynamic* const AppliedDynamic = Cast<UMaterialInstanceDynamic>(AppliedMaterial))
+			{
+				AppliedMaterial = AppliedDynamic->Parent;
+			}
+
+			const FSoftObjectPath AchievedMaterialPath(AppliedMaterial);
+			if (SlotsInspected == 0)
+			{
+				FirstAchievedPath = AchievedMaterialPath.ToString();
+			}
+			++SlotsInspected;
+
+			if (FogVisualMaterialMatches(FogVisualMaterialPath(), AchievedMaterialPath))
+			{
+				bWearingRequestedMaterial = true;
+			}
+		}
+	}
+
+	if (!bWearingRequestedMaterial)
+	{
+		UE_LOG(LogGitClaudeUnrealTest, Error,
+			TEXT("[%s] ⛔⛔ THE FOG VISUAL IS RENDERING WITH THE WRONG MATERIAL — requested '%s', and none of the %d material ")
+			TEXT("slot(s) on its mesh components carries it (first ACHIEVED: '%s'), read back after FinishSpawning ran the ")
+			TEXT("vendor's construction script (AFogVolume::VerifyFogVisualMaterial). ")
+			TEXT("The map entry was verified written BEFORE construction, so reaching this line means the script did not build ")
+			TEXT("from it: either the vendor no longer sources its material from that map, or the visual is running in a ")
+			TEXT("material mode other than the entry that was written. ")
+			TEXT("The fog is UP, the MECHANIC is unaffected and the card is not refused — the box on screen is the vendor's ")
+			TEXT("warm tint, which is the ONE thing this whole path exists to change."),
+			*GetNameSafe(this), *FogVisualMaterialPath().ToString(), SlotsInspected, *FirstAchievedPath);
+	}
+}
