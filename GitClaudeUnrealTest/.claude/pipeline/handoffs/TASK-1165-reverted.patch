+	if (StoredMaterial != RequestedMaterial)
+	{
+		UE_LOG(LogGitClaudeUnrealTest, Error,
+			TEXT("[%s] ⛔⛔ THE FOG VISUAL'S MATERIAL WRITE DID NOT TAKE — '%s[%s]' still holds '%s' after being set to '%s' ")
+			TEXT("(AFogVolume::ApplyFogVisualMaterial). The fog is UP, the MECHANIC is unaffected and the card is not refused; ")
+			TEXT("the box will render in the VENDOR's warm tint. This is a WRITE THAT RETURNED WITHOUT ERROR AND CHANGED ")
+			TEXT("NOTHING — the same shape that made the colour route look finished once already, which is why it is checked ")
+			TEXT("here rather than assumed."),
+			*GetNameSafe(this), *BoxMaterialsPropertyName.ToString(), BaseModeEntryName,
+			*GetNameSafe(StoredMaterial), *GetNameSafe(RequestedMaterial));
+	}
