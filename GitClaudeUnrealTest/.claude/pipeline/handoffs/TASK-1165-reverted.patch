+	if (!bResolvedBaseMode)
+	{
+		UE_LOG(LogGitClaudeUnrealTest, Error,
+			TEXT("[%s] ⛔ THE FOG VISUAL'S MATERIAL MODE '%s' NO LONGER EXISTS — '%s' is keyed by an enum that has no such entry ")
+			TEXT("(AFogVolume::ApplyFogVisualMaterial). The fog is UP, the MECHANIC is unaffected and the card is not refused; ")
+			TEXT("the box will render in the VENDOR's warm tint. The entry is looked up by name on purpose, so a renamed or ")
+			TEXT("reordered vendor mode arrives here instead of writing whichever mode happens to sit at the same index."),
+			*GetNameSafe(this), BaseModeEntryName, *BoxMaterialsPropertyName.ToString());
+		return;
+	}
+
+	// ── (4) THE WRITE — ON THE ⛔ SPAWNED INSTANCE, ⛔ NEVER ON THE ASSET ──────────────────────
+	// ⛔⛔ THIS TOUCHES NO .uasset AND NO .umap. The map is PER-INSTANCE memory, copied off the
+	// class default when the actor was created; writing it here changes THIS actor, which carries
+	// RF_Transient and dies with the fog. The visual Blueprint on disk is not opened, not dirtied
+	// and not saved — the never-save law covers the map, and this row holds the same line for the
+	// Blueprint. ⛔ Nothing in this function marks a package dirty, and nothing may start.
+	void* const MapMemory = BoxMaterialsProperty->ContainerPtrToValuePtr<void>(Visual);
+	FScriptMapHelper MapHelper(BoxMaterialsProperty, MapMemory);
+
+	// ⛔ The key buffer is SIZED AND INITIALISED BY THE PROPERTY ITSELF, never by a hand-typed
+	// integer type: the underlying width of a Blueprint enum is the property's business, not this
+	// call site's, and guessing it wrong would write a key nothing matches.
